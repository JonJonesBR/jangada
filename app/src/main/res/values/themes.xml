<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jangada" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_bg</item>
        <item name="android:statusBarColor">@color/terminal_bg</item>
        <item name="android:navigationBarColor">@color/keys_bg</item>
        <item name="android:colorAccent">@color/key_active</item>
    </style>

    <!-- Telas do app (não o terminal): claro aqui, escuro em values-night. -->
    <style name="Theme.Jangada.Setup" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:navigationBarColor">@color/setup_bg</item>
        <item name="android:colorAccent">@color/key_active</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SetupStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/setup_muted</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="HomeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/setup_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardTextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/key_active</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/setup_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:buttonTint">@color/key_active</item>
    </style>
</resources>
