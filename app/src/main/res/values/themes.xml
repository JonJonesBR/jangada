<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jangada" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_bg</item>
        <item name="android:statusBarColor">@color/terminal_bg</item>
        <item name="android:navigationBarColor">@color/keys_bg</item>
        <item name="android:colorAccent">@color/key_active</item>
    </style>

    <style name="Theme.Jangada.Setup">
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:navigationBarColor">@color/setup_bg</item>
    </style>

    <style name="SetupStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/setup_muted</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="HomeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/setup_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
