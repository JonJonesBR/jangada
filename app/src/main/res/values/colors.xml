    <color name="setup_error_text">#AE3A26</color>
    <color name="setup_muted_text">#4F5F65</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="card_stroke">#DDD5C5</color>
    <color name="chip_bg">#EEE8DC</color>
    <color name="bar_bg">#E7E0D2</color>
    <color name="bar_text">#12303A</color>
    <!-- Âmbar para TEXTO nas telas do app (no tema claro, com contraste suficiente). key_active fica para fundos e para o terminal. -->
    <color name="accent_text">#8F5200</color>
    <color name="input_bg">#FFFFFF</color>
    <!-- Partes da barra de espaço (painel Espaço no Linux): projetos em azul e conversas em roxo. -->
    <color name="storage_projects">#2F6D9A</color>
    <color name="storage_conversations">#6A4C93</color>
