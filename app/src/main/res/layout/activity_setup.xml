<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/setup_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/setup_intro"
            android:textColor="@color/setup_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/step_download"
            style="@style/SetupStep"
            android:layout_marginTop="28dp"
            android:text="@string/setup_step_download" />

        <TextView
            android:id="@+id/step_extract"
            style="@style/SetupStep"
            android:text="@string/setup_step_extract" />

        <TextView
            android:id="@+id/step_packages"
            style="@style/SetupStep"
            android:text="@string/setup_step_packages" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="1000"
            android:progressTint="@color/key_active"
            android:indeterminateTint="@color/key_active"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/setup_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/setup_error"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/key_active"
            android:text="@string/setup_start"
            android:textAllCaps="false"
            android:textColor="@color/setup_on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toggle_log"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/setup_show_log"
            android:textColor="@color/setup_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/log_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/terminal_bg"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/setup_muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/copy_log"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="48dp"
                android:text="@string/setup_copy_log"
                android:textAllCaps="false"
                android:textColor="@color/accent_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
