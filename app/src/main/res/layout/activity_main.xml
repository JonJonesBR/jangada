<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/keys_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/terminal_home_arrow"
            android:textColor="@color/key_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_title_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="14dp"
            android:textColor="@color/setup_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <com.termux.view.TerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAutofill="no"
        android:scrollbars="vertical" />

    <io.github.jonjonesbr.jangada.terminal.ExtraKeysBar
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keys_bg" />
</LinearLayout>
