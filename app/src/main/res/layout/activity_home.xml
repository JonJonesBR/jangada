<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/setup_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/setup_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/open_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_settings"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/setup_muted"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/open_terminal"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:text="@string/home_open_terminal"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/storage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_title"
                android:textColor="@color/setup_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storage_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/setup_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/storage_allow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/key_active"
                android:text="@string/storage_allow"
                android:textAllCaps="false"
                android:textColor="@color/setup_on_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/running_title"
            style="@style/HomeSection"
            android:text="@string/home_running"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/welcome_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_welcome_title"
                android:textColor="@color/setup_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/home_welcome_body"
                android:textColor="@color/setup_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/welcome_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/key_active"
                android:text="@string/home_welcome_ok"
                android:textAllCaps="false"
                android:textColor="@color/setup_on_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/HomeSection"
            android:text="@string/home_agents" />

        <TextView
            android:id="@+id/unsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_unsupported"
            android:textColor="@color/setup_error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/agents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
