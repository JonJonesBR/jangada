<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/setup_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/setup_muted_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/open_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_settings"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/setup_muted_text"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/open_terminal"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:text="@string/home_open_terminal"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/storage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_title"
                android:textColor="@color/setup_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storage_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/setup_muted_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/storage_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/setup_muted_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/storage_details"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textColor="@color/accent_text"
                android:text="@string/storage_details" />

            <Button
                android:id="@+id/projects_open"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textColor="@color/accent_text"
                android:text="@string/projects_open" />

            <Button
                android:id="@+id/storage_allow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/key_active"
                android:text="@string/storage_allow"
                android:textAllCaps="false"
                android:textColor="@color/setup_on_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/running_title"
            style="@style/HomeSection"
            android:text="@string/home_running"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_jobs_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/home_jobs_empty"
            android:textColor="@color/setup_muted_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Botão grande, no topo da seção de trabalhos: visível com o Linux pronto e um agente com chat instalado. -->
        <Button
            android:id="@+id/home_new_job"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/key_active"
            android:text="@string/home_new_job"
            android:textAllCaps="false"
            android:textColor="@color/setup_on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Memória: quanto os agentes usam, o resto dos apps e o livre (ver HomeActivity.renderMemory). -->
        <LinearLayout
            android:id="@+id/home_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/home_memory_bar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/bar_bg"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View
                    android:id="@+id/home_memory_agents"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent_text" />

                <View
                    android:id="@+id/home_memory_other"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/setup_muted" />

                <View
                    android:id="@+id/home_memory_free"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/setup_done" />
            </LinearLayout>

            <!-- Legenda da barra: cada cor com o nome da parte e o valor (ver HomeActivity.renderMemory). -->
            <LinearLayout
                android:id="@+id/home_memory_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_memory_legend_agents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:textColor="@color/setup_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/home_memory_legend_other"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:importantForAccessibility="no"
                    android:textColor="@color/setup_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/home_memory_legend_free"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:textColor="@color/setup_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Quanto dá para usar agora (ver HomeActivity.renderMemory). -->
            <TextView
                android:id="@+id/home_memory_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Previsão para mais um agente (ver HomeActivity.fitMessage); some sem histórico. -->
            <TextView
                android:id="@+id/home_memory_fit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Filtros da lista de trabalhos (com 4 ou mais linhas): Todos, Esperando você e as pastas. -->
        <HorizontalScrollView
            android:id="@+id/job_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/job_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/welcome_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_welcome_title"
                android:textColor="@color/setup_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/home_welcome_body"
                android:textColor="@color/setup_muted_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/welcome_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/key_active"
                android:text="@string/home_welcome_ok"
                android:textAllCaps="false"
                android:textColor="@color/setup_on_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
            Título da seção de agentes, com Atualizar todos à direita (aparece com 2 ou mais para atualizar).
            Altura mínima de 48dp, a do botão: o título não muda de altura quando o botão aparece, e a
            lista não desce. As margens compensam o espaço que o mínimo acrescenta.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HomeSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/home_agents" />

            <Button
                android:id="@+id/update_all"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textColor="@color/accent_text"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/unsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_unsupported"
            android:textColor="@color/setup_error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/agents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
