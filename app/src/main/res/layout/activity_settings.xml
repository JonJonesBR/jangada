<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settings_back"
            style="@style/BarButton"
            android:text="@string/terminal_home_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/setup_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/HomeSection"
                android:layout_marginTop="0dp"
                android:text="@string/settings_mode" />

            <RadioGroup
                android:id="@+id/settings_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/mode_simple"
                    style="@style/SettingsOption"
                    android:text="@string/settings_mode_simple" />

                <RadioButton
                    android:id="@+id/mode_pro"
                    style="@style/SettingsOption"
                    android:text="@string/settings_mode_pro" />
            </RadioGroup>

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_appearance" />

            <RadioGroup
                android:id="@+id/settings_app_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/theme_system" style="@style/SettingsOption" android:text="@string/theme_system" />
                <RadioButton android:id="@+id/theme_light" style="@style/SettingsOption" android:text="@string/theme_light" />
                <RadioButton android:id="@+id/theme_dark" style="@style/SettingsOption" android:text="@string/theme_dark" />
            </RadioGroup>

            <Button
                android:id="@+id/settings_terminal_theme"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_typing" />

            <Switch
                android:id="@+id/settings_enter_sends"
                style="@style/SettingsOption"
                android:text="@string/settings_enter_sends" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_chat" />

            <RadioGroup
                android:id="@+id/settings_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/permissions_ask"
                    style="@style/SettingsOption"
                    android:text="@string/settings_permissions_ask" />

                <RadioButton
                    android:id="@+id/permissions_auto"
                    style="@style/SettingsOption"
                    android:text="@string/settings_permissions_auto" />
            </RadioGroup>

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_model" />

            <RadioGroup
                android:id="@+id/settings_model_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/model_default"
                    style="@style/SettingsOption"
                    android:text="@string/chat_model_default" />

                <RadioButton
                    android:id="@+id/model_opus"
                    style="@style/SettingsOption"
                    android:text="Opus" />

                <RadioButton
                    android:id="@+id/model_sonnet"
                    style="@style/SettingsOption"
                    android:text="Sonnet" />

                <RadioButton
                    android:id="@+id/model_haiku"
                    style="@style/SettingsOption"
                    android:text="Haiku" />
            </RadioGroup>

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_effort" />

            <RadioGroup
                android:id="@+id/settings_effort_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/effort_default" style="@style/SettingsOption" android:text="@string/chat_effort_default" />
                <RadioButton android:id="@+id/effort_low" style="@style/SettingsOption" android:text="@string/effort_low" />
                <RadioButton android:id="@+id/effort_medium" style="@style/SettingsOption" android:text="@string/effort_medium" />
                <RadioButton android:id="@+id/effort_high" style="@style/SettingsOption" android:text="@string/effort_high" />
                <RadioButton android:id="@+id/effort_xhigh" style="@style/SettingsOption" android:text="@string/effort_xhigh" />
                <RadioButton android:id="@+id/effort_max" style="@style/SettingsOption" android:text="@string/effort_max" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_other_agents"
                android:textColor="@color/setup_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_permissions_note"
                android:textColor="@color/setup_muted"
                android:textSize="13sp" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_advanced" />

            <Switch
                android:id="@+id/settings_cpu_awake"
                style="@style/SettingsOption"
                android:text="@string/settings_cpu_awake" />

            <Switch
                android:id="@+id/settings_screen_on"
                style="@style/SettingsOption"
                android:text="@string/settings_screen_on" />

            <Switch
                android:id="@+id/settings_extra_keys"
                style="@style/SettingsOption"
                android:text="@string/settings_extra_keys" />

            <Button
                android:id="@+id/settings_api_keys"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/keys_title"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_linux" />

            <TextView
                android:id="@+id/settings_linux_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/setup_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/settings_cleanup"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cleanup"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_repair"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_repair"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_reinstall"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_reinstall"
                android:textAllCaps="false"
                android:textColor="@color/setup_error" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_backup" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_intro"
                android:textColor="@color/setup_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/settings_backup_export"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_export"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_backup_import"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_import"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_about"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/about_title"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
