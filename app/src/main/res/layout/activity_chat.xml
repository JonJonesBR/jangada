<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chat_home"
            style="@style/BarButton"
            android:text="@string/terminal_home_arrow" />

        <!-- Título e subtítulo formam um só alvo de toque (48dp): tocar abre os trabalhos (trocar de pasta ou de agente). -->
        <LinearLayout
            android:id="@+id/chat_title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/chat_title"
                android:textColor="@color/setup_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chat_terminal"
            style="@style/BarButton"
            android:contentDescription="@string/chat_terminal"
            android:fontFamily="monospace"
            android:text="&gt;_" />

        <!-- Menu: nova conversa, histórico, trabalhos, mudanças, encerrar trabalho isolado e ajustes. -->
        <TextView
            android:id="@+id/chat_menu"
            style="@style/BarButton"
            android:contentDescription="@string/chat_menu"
            android:text="⋮"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- A lista e o botão de ir ao fim ficam sobrepostos; o FrameLayout tem o peso que era da lista. -->
    <FrameLayout
        android:id="@+id/chat_list_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:stackFromBottom="true"
            android:transcriptMode="normal" />

        <!-- Ir para o fim da conversa: aparece quando a lista não está no fim. Círculo de 40dp (jump_bg) dentro
             do toque de 48dp, que segue sendo o alvo para acessibilidade; semitransparente para não tapar a conversa. -->
        <TextView
            android:id="@+id/chat_jump_end"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:alpha="0.85"
            android:background="@drawable/jump_bg"
            android:contentDescription="@string/chat_jump_end"
            android:elevation="4dp"
            android:gravity="center"
            android:text="↓"
            android:textColor="@color/setup_text"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/chat_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:padding="32dp"
        android:text="@string/chat_empty"
        android:textColor="@color/setup_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Falha ao preparar o adaptador: tentar de novo ou ver o log completo. -->
    <LinearLayout
        android:id="@+id/chat_prepare_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/chat_prepare_retry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_prepare_retry"
            android:textAllCaps="false"
            android:textColor="@color/accent_text" />

        <Button
            android:id="@+id/chat_prepare_details"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_prepare_details"
            android:textAllCaps="false"
            android:textColor="@color/accent_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/chat_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/chat_continue"
        android:textColor="@color/accent_text"
        android:textSize="14sp"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/chat_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/chat_status_spinner"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/key_active" />

        <TextView
            android:id="@+id/chat_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="@string/chat_working"
            android:textColor="@color/setup_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chat_stop"
            style="@style/BarButton"
            android:text="@string/chat_stop"
            android:textColor="@color/setup_error" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chat_attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Pedido de permissão pendente, fixo acima dos atalhos (ver ChatActivity.updatePermissionBar).
         O cartão do pedido continua na conversa. Sem anúncio próprio: o chat já anuncia pedidos novos. -->
    <LinearLayout
        android:id="@+id/chat_permission_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/setup_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chat_permission_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/setup_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Só "Detalhes": Permitir e Recusar ficam no cartão da conversa (ver ChatActivity.permissionCard). -->
        <Button
            android:id="@+id/chat_permission_details"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_permission_details"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Atalhos acima da caixa: pasta, modelo, visualização, contexto e mudanças (ver ChatActivity.updateQuickbar).
         As views ficam aqui; o código só muda texto, descrição e visibilidade. -->
    <HorizontalScrollView
        android:id="@+id/chat_quickbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chat_chip_folder"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_model"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_mode"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_view"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_context"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_limits"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_chip_changes"
                style="@style/QuickChip"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/chat_attach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_attach"
            android:gravity="center"
            android:text="📎"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/compose_bg"
            android:hint="@string/chat_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:maxLines="6"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/setup_text"
            android:textColorHint="@color/setup_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chat_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/compose_send"
            android:gravity="center"
            android:text="➤"
            android:textColor="@color/accent_text"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
