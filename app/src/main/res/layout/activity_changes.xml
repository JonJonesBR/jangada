<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:orientation="vertical">

    <!-- Barra do topo, como a do chat: voltar, pasta · branch e atualizar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/changes_back"
            style="@style/BarButton"
            android:text="@string/changes_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/changes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/changes_title"
                android:textColor="@color/setup_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/changes_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/changes_refresh"
            style="@style/BarButton"
            android:contentDescription="@string/changes_refresh"
            android:text="↻"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/changes_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/setup_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/changes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:visibility="gone" />

    <!-- Sem mudanças, ou pasta que não é repositório git: o texto diz o que houve. -->
    <TextView
        android:id="@+id/changes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:padding="32dp"
        android:textColor="@color/setup_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/changes_commit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/changes_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/compose_bg"
            android:hint="@string/changes_message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/setup_text"
            android:textColorHint="@color/setup_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/changes_commit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/changes_commit"
            android:textAllCaps="false"
            android:textColor="@color/accent_text" />
    </LinearLayout>
</LinearLayout>
