{
  "id": "antigravity",
  "order": 20,
  "name": "Antigravity CLI (agy)",
  "vendor": "Google",
  "command": "agy",
  "install": "curl -fsSL --connect-timeout 20 --retry 3 --speed-limit 1000 --speed-time 60 https://antigravity.google/cli/install.sh | bash",
  "homepage": "https://antigravity.google/docs/cli/overview",
  "description": {
    "pt": "Agente do Google, sucessor do Gemini CLI.",
    "en": "Google's agent, successor to Gemini CLI."
  },
  "note": {
    "pt": "Nesta versão, só no terminal.",
    "en": "Terminal only for now."
  },
  "uninstall": "rm -rf ~/.local/share/agy-acp"
}
